<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="open_manipulator_x" params="prefix:='' 
    ic_joints:=${[0.0, 0.0, 0.0, 0.0]}">

    <xacro:property
      name="meshes_file_direction"
      value="package://open_manipulator_x_description/meshes"/>

    <xacro:property name="CoM_link0" value="${[2.0, 0.0, 0.0]}" />

    <link name="${prefix}link0">
      <visual>
        <origin xyz="0.0011 -0.0001 0.0194" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link0_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0.0011 -0.0001 0.0194" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link0_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.00011 -0.001 0.0194" />
        <mass value="8.2e-02" />
        <inertia ixx="18.5495e-06" ixy="-0.1704e-06" ixz="0.3415e-06"
                 iyy="29.4750e-06" iyz="0.0015e-06"
                 izz="23.0866e-06" />
      </inertial> 
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}link0"/>
      <child link="${prefix}link1"/>

      <origin xyz="0.012 0 0.036" rpy="${ic_joints[0]} 0  0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <dynamics damping="0.1"/>
    </joint>

    
    <link name="${prefix}link1">
      <visual>
        <origin xyz="0 0.0 0.0277" rpy="1.578 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link1_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0.0 0.0277" rpy="1.578 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link1_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

       <inertial>
        <origin xyz="0 0 0.0277 "/>
        <mass value="10.5e-02" />
        <inertia ixx="45.0914e-06" ixy="-0.1136e-06" ixz="-0.0084e-06"
                 iyy="23.7269e-06" iyz="-0.2222e-06"
                 izz="35.9688e-06" />
      </inertial>
    </link>


    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0 0.0 0.0433" rpy="1.578 ${ic_joints[1]} 0"/>
       <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link2">
      <visual>
        <origin xyz="0.0924 0.0106 0.0003" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link2_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0.0924 0.0106 0.0003" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link2_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

       <inertial>
         <origin xyz="0.0924 0.0106 0.0003" />
        <mass value="14.2e-02" />
        <inertia ixx="36.9717e-06" ixy="-7.5128e-06" ixz="0.7972e-06"
                 iyy="236.0399e-06" iyz="0.1582e-06"
                 izz="233.5145e-06" />
      </inertial>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="0.1317 0 0" rpy="0 ${ic_joints[2]} 0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link3">
      <visual>
        <origin xyz="0.0816 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link3_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0.0816 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link3_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

       <inertial>
         <origin xyz="0.0816 0 0" />
        <mass value="13.5e-02" />
        <inertia ixx="26.8442e-06" ixy="-0.3549e-06" ixz="0.5156e-06"
                 iyy="193.8335e-06" iyz="0.0095e-06"
                 izz="181.4661e-06" />
      </inertial>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0.1253 0.0 0.0" rpy="0 ${ic_joints[3]} 0"/>
      <axis xyz="0 0 1"/>
       <!--
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      -->
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link4">
      <visual>
        <origin xyz="0.0415 -0.00574 0" rpy="1.57 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link4_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0.0415 -0.00574 0" rpy="1.57 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/link4_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>


      <!-- TODO Compute again the inertia matrix as 3 difference pieces and not like a unique piece-->
      <inertial>
        <origin xyz="0.0702 0.0035 0" />
        <mass value="23.6e-02" />
        <inertia ixx="237.6911e-06" ixy="20.1638e-06" ixz="-0.0052e-06"
                 iyy="363.9779e-06" iyz="0.0704e-06"
                 izz="243.4494e-06" />
      </inertial>
    </link>

    <joint name="${prefix}gripper_left_joint" type="prismatic">
      <parent link="${prefix}link4"/>
      <child link="${prefix}gripper_left_link"/>
      <origin rpy="-1.56 0 -1.56" xyz="0.0665 0 0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}gripper_left_link">
      
      <visual>
        <origin xyz="0 0.0452 0.0274" rpy="0 -1.57 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/gripper_left_palm_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>
      
      <collision>
        <origin xyz="0 0.0452 0.0274" rpy="0 -1.57 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/gripper_left_palm_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0.0452 0.0274" rpy="0 -1.57 0"/>
        <mass value="1.0e-06" />
        <inertia ixx="1.0e-12" ixy="0.0" ixz="0.0"
                 iyy="1.0e-12" iyz="0.0"
                 izz="1.0e-12" />
      </inertial>
    </link> 

    <joint name="${prefix}gripper_right_joint_mimic" type="fixed">
      <parent link="${prefix}gripper_right_link" />
      <child link="dummy_mimic_fix" />
    </joint>
    <link name="dummy_mimic_fix"/>

    <joint name="${prefix}gripper_right_joint" type="prismatic">
      <parent link="${prefix}link4"/>
      <child link="${prefix}gripper_right_link"/>
      <origin rpy="-1.56 0 -1.56" xyz="0.0665 0 0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="4.1" lower="${-3.14}" upper="${3.14}" />
      <mimic joint="${prefix}gripper_left_joint" multiplier="1"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}gripper_right_link">
      
      <visual>
        <origin xyz="0 -0.0452 0.0274" rpy="0 -1.57 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/gripper_right_palm_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>
      
      <collision>
        <origin xyz="0 -0.0452 0.0274" rpy="0 -1.57 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/pieces_CoM/gripper_right_palm_CoM.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
     
      <inertial>
        <origin xyz="0 -0.0452 0.0274" rpy="0 -1.57 0"/>
        <mass value="1.0e-06" />
        <inertia ixx="1.0e-12" ixy="0.0" ixz="0.0"
                 iyy="1.0e-12" iyz="0.0"
                 izz="1.0e-12" />
      </inertial>
    </link>

    <joint name="${prefix}end_effector_joint" type="fixed">
      <parent link="${prefix}link4"/>
      <child link="${prefix}end_effector_link"/>
      <origin xyz="0.126 0.0 0.0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}end_effector_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="red"/>
       </visual>
    </link>

  </xacro:macro>

</robot>
